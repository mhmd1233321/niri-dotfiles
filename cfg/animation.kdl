animations {
    // الانتقال بين الـ Workspaces (رفعنا الـ Stiffness شوية لسرعة الانتقال)
    workspace-switch {
        spring damping-ratio=1.0 stiffness=350 epsilon=0.0001
    }

    // فتح الشبابيك (استجابة سريعة ومرنة)
    window-open {
        spring damping-ratio=1.0 stiffness=380 epsilon=0.0001
    }

    // إغلاق الشبابيك (سريع وبدون تأخير - ممتاز)
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    // حركة الشاشة والأعمدة أفقياً (Smooth ومريح للعين)
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=320 epsilon=0.0001
    }

    // تحريك الشبابيك يدوي بالماوس/الكيبورد
    window-movement {
        spring damping-ratio=1.0 stiffness=350 epsilon=0.0001
    }

    // تغيير حجم الشباك (حوّلناه لـ Curve أسرع وأخف على الـ GPU)
    window-resize {
        duration-ms 180
        curve "ease-out-cubic"
    }

    // الـ Overview (فتح وإغلاق العرض العام)
    overview-open-close {
        spring damping-ratio=1.0 stiffness=350 epsilon=0.0001
    }

    config-notification-open-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    screenshot-ui-open {
        duration-ms 150
        curve "ease-out-quad"
    }
}

